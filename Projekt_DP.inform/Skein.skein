  <item nodeId="node-2188">
    <command xml:space="preserve">go north</command>
    <result xml:space="preserve">The river is too wide and fast to cross by jumping. Maybe something could help you over?&#x000A;Should I cross over?&#x000A;&#x000A;&gt;</result>
    <commentary xml:space="preserve"></commentary>
    <changed>NO</changed>
