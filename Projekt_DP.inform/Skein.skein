  <item nodeId="node-626">
    <command xml:space="preserve">name duck as la</command>
    <result xml:space="preserve">You name the duck "la". It seems happy.&#x000A;&#x000A;Voice through the wind: "Try PET DUCK to bond."&#x000A;&gt;</result>
