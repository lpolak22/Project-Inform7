  <item nodeId="node-569">
    <command xml:space="preserve">go north</command>
    <result xml:space="preserve">Forest&#x000A;You are in a dense forest. You hear a waterfall nearby and voices talking in the distance.&#x000A;&#x000A;You can see ForestDoor here.&#x000A;&#x000A;&gt;</result>
